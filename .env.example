# SimpliiGood Creator Club server (v0.3). Copy to .env and export, or set in your host.
# All variables are optional for local development.

PORT=8765
CLUB_HOST=127.0.0.1                 # use 0.0.0.0 behind a reverse proxy
CLUB_BASE_URL=                      # public URL, e.g. https://club.example.com (needed for links behind a proxy)
CLUB_DATA_DIR=./data                # state.json, auth.json and the dev outbox live here
CLUB_SECRET=                        # >= 32 random characters; required when NODE_ENV=production
CLUB_ADMIN_EMAILS=admin@example.test # comma-separated programme admins
CLUB_SESSION_DAYS=30
CLUB_LINK_MINUTES=15
CLUB_AUTH_LIMIT=20                  # sign-in link requests per IP per 15 minutes

# dev: sign-in links are written to data/outbox and shown in the UI (no real e-mail)
# webhook: POST {from,to,subject,text} to CLUB_MAIL_WEBHOOK_URL (any mail relay or automation endpoint)
CLUB_MAIL_MODE=dev
CLUB_MAIL_WEBHOOK_URL=
CLUB_MAIL_WEBHOOK_AUTH=             # e.g. "Bearer <token>", sent as the Authorization header
CLUB_MAIL_FROM=SimpliiGood Creator Club <no-reply@example.test>
